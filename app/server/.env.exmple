GEMINI_API_KEY=your_gemini_api_key_here

# Log verbosity: error | warn | info | debug. Default is info.
# Use debug to see why a playlist came out the way it did, how the catalog is
# growing, and every round transition.
# LOG_LEVEL=info

# --- Song catalog (all optional, sensible defaults in code) ---

# Where the catalog database lives. On Fly this points at the mounted volume.
# CATALOG_DB_PATH=./.data/catalog.db

# Set to false to never grow the catalog on this instance (useful in dev).
# CATALOG_REFRESH_ENABLED=true

# How long after boot the catalog refresh starts, so it does not compete with
# the player whose visit just woke the machine.
# CATALOG_BOOT_DELAY_MS=20000

# How many AI calls a single refresh may make, and how far apart. There is no
# local quota counter on purpose: the API is the authority on its own limits,
# and a refresh simply stops when it gets a 429.
# CATALOG_REFRESH_MAX_CALLS=4
# GEMINI_MIN_INTERVAL_MS=15000
# CATALOG_SONGS_PER_CALL=25

# Upkeep: how many previews to re-check per run, and how many confirmed
# failures before a song is dropped.
# CATALOG_REVALIDATE_PER_RUN=20
# CATALOG_DEAD_THRESHOLD=3

# When the measured difficulty starts overriding the one the AI claimed.
# DIFFICULTY_MIN_PLAYS=5
# DIFFICULTY_MS_THRESHOLD=12000
